{
  "name": "pocketpilot",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.16.0",
    "npm": "11.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm ci",
    "baseline": "node scripts/baseline.mjs",
    "check:lockfiles": "node scripts/check-lockfiles.mjs",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:core": "tsc --noEmit -p packages/core/tsconfig.json",
    "typecheck:services": "tsc --noEmit -p packages/services/tsconfig.json",
    "typecheck:shared": "npm run typecheck:core && npm run typecheck:services",
    "typecheck:mobile": "tsc --noEmit -p apps/mobile/tsconfig.json",
    "test:unit": "vitest run",
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "mobile:start": "npm --prefix apps/mobile run start",
    "backend:functions:build": "npm --prefix backend/functions run build",
    "backend:emulators": "cd backend/firebase && npx firebase-tools emulators:start --config firebase.json",
    "backend:qdrant:up": "docker compose -f backend/infra/docker-compose.yml up -d",
    "backend:qdrant:down": "docker compose -f backend/infra/docker-compose.yml down",
    "docker:up": "npm install && docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:web:prod": "DOCKER_BUILDKIT=1 docker build -f docker/web.prod.Dockerfile -t pocketpilot-web-prod .",
    "docker:mobile:dev": "DOCKER_BUILDKIT=1 docker build -f docker/mobile.Dockerfile -t pocketpilot-mobile-dev .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/node": "25.3.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.11",
    "metro": "^0.82.5",
    "metro-config": "^0.82.5",
    "metro-resolver": "^0.82.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@react-navigation/native": "^7.3.1",
    "expo-router": "~6.0.24",
    "react-native-worklets": "^0.5.1"
  }
}
