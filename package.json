{
  "name": "pocketpilot",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install",
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "mobile:start": "npm --prefix apps/mobile run start",
    "backend:functions:build": "npm --prefix backend/functions run build",
    "backend:emulators": "cd backend/firebase && npx firebase-tools emulators:start --config firebase.json",
    "backend:qdrant:up": "docker compose -f backend/infra/docker-compose.yml up -d",
    "backend:qdrant:down": "docker compose -f backend/infra/docker-compose.yml down",
    "docker:up": "npm install && docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:web:prod": "DOCKER_BUILDKIT=1 docker build -f docker/web.prod.Dockerfile -t pocketpilot-web-prod .",
    "docker:mobile:dev": "DOCKER_BUILDKIT=1 docker build -f docker/mobile.Dockerfile -t pocketpilot-mobile-dev ."
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.11",
    "metro": "^0.82.5",
    "metro-config": "^0.82.5",
    "metro-resolver": "^0.82.5",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
