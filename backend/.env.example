# Firebase emulator env
# Set when running cloud functions that call Qdrant locally.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=pocketpilot_vectors

# Ollama local server and models for RAG assistant
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Rust services
POCKETPILOT_PROJECT_ID=demo-pocketpilot
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Production / non-emulator Firestore access for Rust services
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
