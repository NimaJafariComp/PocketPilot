# Explicit local development profile (never use for a release build)
VITE_RELEASE_PROFILE=development
VITE_CAPABILITY_USE_EMULATORS=true
# Frontend -> Firebase emulator
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=pocketpilot-local.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pocketpilot-local
VITE_FIREBASE_APP_ID=1:000000000000:web:local
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# Staging/release only: public reCAPTCHA Enterprise site key. Never use debug tokens.
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Monitoring is the default. Console enforcement is a separate, staged decision.
VITE_FIREBASE_APPCHECK_ENFORCEMENT=false

# Frontend -> Cloud Functions emulator base URL
VITE_FUNCTIONS_BASE_URL=http://127.0.0.1:5001/pocketpilot-local/us-central1
