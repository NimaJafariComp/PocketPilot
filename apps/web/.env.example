# Frontend -> Firebase (local defaults work with emulator)
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=pocketpilot-local.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pocketpilot-local
VITE_FIREBASE_APP_ID=1:000000000000:web:local
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# Frontend -> Cloud Functions emulator base URL
VITE_FUNCTIONS_BASE_URL=http://127.0.0.1:5001/pocketpilot-local/us-central1
